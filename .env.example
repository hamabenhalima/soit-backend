PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=
FRONTEND_URL=https://hamabenhalima.github.io/SOIT-Infrastructure-Website
CORS_ORIGINS=https://hamabenhalima.github.io
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_FROM_EMAIL=verified-sender@example.com
CONTACT_NOTIFICATION_EMAIL=company-inbox@example.com

# Set to gmail to use Gmail SMTP instead of Brevo.
# Google requires 2-Step Verification to create an App Password.
EMAIL_PROVIDER=brevo
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Use these for a branded mailbox from your domain/email host (EMAIL_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SOIT Infrastructure

# Used only when running `npm run admin:create` to create/promote the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=soit-admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
